# ============================================================
# STOCK INTELLIGENCE - Environment Variables
# Copy ke .env dan isi nilainya. JANGAN commit .env ke git.
# ============================================================

# --- App ---
APP_ENV=development
SECRET_KEY=change-me-to-random-64-char-string
DEBUG=true
LOG_LEVEL=INFO

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=stock_intelligence
POSTGRES_USER=stock_user
POSTGRES_PASSWORD=change_me_password
DATABASE_URL=postgresql+asyncpg://stock_user:change_me_password@localhost:5432/stock_intelligence
DATABASE_URL_SYNC=postgresql://stock_user:change_me_password@localhost:5432/stock_intelligence

# --- Redis (optional, untuk job queue di masa depan) ---
REDIS_URL=redis://localhost:6379/0

# --- Anthropic API ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-5
AI_DAILY_TOKEN_BUDGET=500000
AI_CACHE_TTL_SECONDS=3600

# --- Data Providers ---
# yfinance: tidak perlu API key (personal use / research)
YFINANCE_ENABLED=true

# Financial Modeling Prep (opsional, untuk fundamental US)
FMP_API_KEY=
FMP_ENABLED=false

# FRED (makro US/global)
FRED_API_KEY=

# BPS WebAPI (makro Indonesia)
BPS_API_KEY=

# --- Timezone ---
DEFAULT_TIMEZONE=Asia/Jakarta
IDX_TIMEZONE=Asia/Jakarta
NYSE_TIMEZONE=America/New_York

# --- Portfolio ---
BASE_CURRENCY=IDR
DEFAULT_MARKET=IDX

# --- Security ---
SESSION_EXPIRE_SECONDS=86400
ALLOWED_ORIGINS=http://localhost:3000
