# ============================================================
# Stock Intelligence API — Environment Variables
# Salin file ini: cp .env.example .env
# JANGAN commit file .env ke git
# ============================================================

# --- App ---
APP_ENV=development          # development | test | production
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=ganti-dengan-string-acak-min-32-karakter  # wajib diganti sebelum production

# --- Database (PostgreSQL) ---
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://stock_user:change_me_password@localhost:5432/stock_intelligence
DATABASE_URL_SYNC=postgresql://stock_user:change_me_password@localhost:5432/stock_intelligence
# Pool settings (abaikan untuk SQLite/test)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Anthropic / TokenPlus (opsional, untuk fitur AI evidence report) ---
# Pakai Anthropic langsung: isi ANTHROPIC_API_KEY, kosongkan ANTHROPIC_BASE_URL
# Pakai TokenPlus proxy: isi keduanya — API key dari TokenPlus, base URL endpoint TokenPlus
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=          # contoh: https://api.tokenplus.ai  (kosong = Anthropic langsung)
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_DAILY_TOKEN_BUDGET=500000
AI_CACHE_TTL_SECONDS=3600

# --- Market Data Providers ---
# yfinance: gratis, personal use only, rate limit ~100 req/menit
YFINANCE_ENABLED=true

# FMP (Financial Modeling Prep) — opsional, butuh API key berbayar
FMP_API_KEY=
FMP_ENABLED=false

# FRED (Federal Reserve Economic Data) — gratis dengan API key
FRED_API_KEY=

# BPS (Badan Pusat Statistik Indonesia) — gratis dengan API key
BPS_API_KEY=

# Sectors Financial API (sectors.app) — data fundamental IDX berkualitas tinggi
# Daftar di https://sectors.app/api untuk mendapatkan API key
# Jika aktif, Sectors akan dipakai sebagai provider fundamental IDX (prioritas > yfinance)
SECTORS_API_KEY=
SECTORS_ENABLED=false

# OpenBB Platform — experimental, US-focused, 500+ rasio finansial
# Install: pip install openbb
# PAT opsional dari openbb.co (tambah akses data premium)
OPENBB_ENABLED=false
OPENBB_PAT=

# --- Intraday Polling ---
# Polling harga terkini setiap 5 menit saat jam bursa berlangsung
# IDX: 09:00-15:49 WIB | NYSE: 09:30-15:59 EST
INTRADAY_POLLING_ENABLED=true

# --- IDX Bootstrap ---
# Berapa hari histori OHLCV saat bootstrap IDX (default: 1825 = 5 tahun)
IDX_BOOTSTRAP_DAYS=1825

# --- Timezone ---
DEFAULT_TIMEZONE=Asia/Jakarta
IDX_TIMEZONE=Asia/Jakarta
NYSE_TIMEZONE=America/New_York

# --- Portfolio ---
BASE_CURRENCY=IDR
DEFAULT_MARKET=IDX

# --- Security ---
SESSION_EXPIRE_SECONDS=86400
# Origins yang boleh akses API (pisahkan dengan koma jika lebih dari satu)
ALLOWED_ORIGINS=http://localhost:3000

# --- PostgreSQL (untuk docker-compose) ---
POSTGRES_DB=stock_intelligence
POSTGRES_USER=stock_user
POSTGRES_PASSWORD=change_me_password
